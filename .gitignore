# ==============================================================================
# Android TV OSCam CAS Bridge - Professional .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Artifacts & Output Directories
# ------------------------------------------------------------------------------
# IMPORTANT: The root /build/ folder contains AOSP build recipes (Android.bp,
# device.mk, vendor.oscam.cas-service.rc, CMakeLists.txt). It MUST NOT be ignored!
!/build/
!/build/**

# Output directories generated by compilers and build systems
build_android/
build_host/
build_out/
build_native/
build-*/
cmake-build-*/
out/
bin/
obj/
target/
**/build/

# Native C / C++ compiled objects and libraries
*.o
*.obj
*.so
*.a
*.la
*.lai
*.dylib
*.dll
*.exe
!app/src/main/jniLibs/**
*.d
*.ninja
*.ninja_deps
*.ninja_log
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# ------------------------------------------------------------------------------
# Android & Gradle
# ------------------------------------------------------------------------------
.gradle/
.cxx/
build/intermediates/
build/outputs/
build/tmp/
local.properties
.gradletasknamecache
gradle-app.setting

# Android packaged binaries and caches
*.apk
*.ap_
*.aab
*.dex
*.class
*.aar

# Proguard / R8 mapping & debug files
proguard/
mapping.txt
configuration.txt
seeds.txt
usage.txt

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------

# Android Studio & IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
*.sww
.idea_modules/
captures/
externalNativeBuild/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# CLion & NetBeans
.clion/
nbproject/private/

# Eclipse
.project
.classpath
.settings/
.cproject

# ------------------------------------------------------------------------------
# Security, Signing & Private Configuration
# ------------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pem
*.key
signing.properties
google-services.json
secring.gpg

# ------------------------------------------------------------------------------
# Logs, Diagnostics & Core Dumps
# ------------------------------------------------------------------------------
*.log
*.log.*
*.dmp
*.stackdump
core
core.*
vgcore.*
scratch_*.py
private/

# ------------------------------------------------------------------------------
# Operating System Temporary Files
# ------------------------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
*.swp
*.swo
.fuse_hidden*
.directory
